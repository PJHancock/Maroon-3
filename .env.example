# Keep the real key in a local .env file. Never commit it.
ANTHROPIC_API_KEY=
# Keep DEMO_MODE=1 for free deterministic responses. Set DEMO_MODE=0 to use Claude.
DEMO_MODE=1
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=20
APP_TIMEZONE=America/Denver
ALLOW_RESET=1
# Optional: point this at a scratch file instead of backend/db.json.
DB_PATH=
HOST=127.0.0.1
PORT=8000
