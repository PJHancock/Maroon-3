# Copy to backend/.env. Never commit your actual API key.
DEMO_MODE=1
DEMO_DATE=2026-10-02
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=20
APP_TIMEZONE=America/Denver
ALLOW_RESET=1
# Normally unnecessary: FastAPI serves frontend/ on the same origin.
CORS_ORIGINS=
# Optional absolute paths; defaults are relative to backend/, not your terminal.
# DB_PATH=/absolute/path/db.json
# FRONTEND_DIR=/absolute/path/frontend
